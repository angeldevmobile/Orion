use "db" as db
use "env" as env
use "timewarp" as tw
URL = env.pull("ORION_PG_URL")
N = 1000000
fn rps(n, s) { if s <= 0 { return "inf" } return str(int(n / s)) }

db.ejecutar(URL, "DROP TABLE IF EXISTS millon")
db.ejecutar(URL, "CREATE TABLE millon (id INTEGER, nombre TEXT, valor INTEGER)")

reloj = tw.clock()
filas = []
i = 0
while i < N {
    filas.push([i, "x" + str(i), i])
    i = i + 1
}
show "1M filas construidas: " + str(tw.elapsed(reloj)) + "s"

reloj = tw.clock()
n = db.copiar(URL, "millon", ["id", "nombre", "valor"], filas)
tC = tw.elapsed(reloj)
show "COPY 1,000,000 filas: " + str(tC) + "s  → " + rps(n, tC) + " filas/s"

reloj = tw.clock()
r = db.uno(URL, "SELECT count(*) as c, avg(valor) as a FROM millon")
show "agregado sobre 1M: " + str(tw.elapsed(reloj)) + "s → n=" + str(r["c"])

db.ejecutar(URL, "DROP TABLE millon")
db.cerrar(URL)
