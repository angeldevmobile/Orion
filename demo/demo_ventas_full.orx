use "excel" as excel

vendedores = [
    {"id": 1,  "nombre": "Ana García",     "region": "Norte",  "producto": "CRM Pro",         "venta": 85000,  "meta": 80000,  "activo": yes, "meses": 24, "ingreso": "15/01/2024"},
    {"id": 2,  "nombre": "Luis Martínez",  "region": "Sur",    "producto": "Analytics Suite", "venta": 62000,  "meta": 70000,  "activo": yes, "meses": 18, "ingreso": "03/07/2024"},
    {"id": 3,  "nombre": "Marta López",    "region": "Norte",  "producto": "Cloud Storage",   "venta": 91000,  "meta": 85000,  "activo": yes, "meses": 36, "ingreso": "20/01/2023"},
    {"id": 4,  "nombre": "Carlos Ruiz",    "region": "Centro", "producto": "Security Pack",   "venta": 74000,  "meta": 75000,  "activo": yes, "meses": 12, "ingreso": "10/01/2025"},
    {"id": 5,  "nombre": "Elena Díaz",     "region": "Oeste",  "producto": "DevOps Tools",    "venta": 110000, "meta": 90000,  "activo": yes, "meses": 48, "ingreso": "05/01/2022"},
    {"id": 6,  "nombre": "Pedro Sánchez",  "region": "Sur",    "producto": "CRM Pro",         "venta": 55000,  "meta": 65000,  "activo": yes, "meses": 8,  "ingreso": "12/05/2025"},
    {"id": 7,  "nombre": "Isabel Torres",  "region": "Norte",  "producto": "Analytics Suite", "venta": 78000,  "meta": 75000,  "activo": yes, "meses": 30, "ingreso": "08/07/2023"},
    {"id": 8,  "nombre": "Miguel Flores",  "region": "Centro", "producto": "Cloud Storage",   "venta": 43000,  "meta": 60000,  "activo": no,  "meses": 6,  "ingreso": "01/07/2025"},
    {"id": 9,  "nombre": "Laura Vega",     "region": "Oeste",  "producto": "Security Pack",   "venta": 96000,  "meta": 88000,  "activo": yes, "meses": 42, "ingreso": "15/07/2022"},
    {"id": 10, "nombre": "Roberto Silva",  "region": "Norte",  "producto": "DevOps Tools",    "venta": 67000,  "meta": 70000,  "activo": yes, "meses": 15, "ingreso": "22/10/2024"},
    {"id": 11, "nombre": "Carmen Medina",  "region": "Sur",    "producto": "CRM Pro",         "venta": 81000,  "meta": 78000,  "activo": yes, "meses": 22, "ingreso": "14/03/2024"},
    {"id": 12, "nombre": "Javier Castro",  "region": "Centro", "producto": "Analytics Suite", "venta": 58000,  "meta": 65000,  "activo": yes, "meses": 10, "ingreso": "05/03/2025"},
    {"id": 13, "nombre": "Patricia Mora",  "region": "Oeste",  "producto": "Cloud Storage",   "venta": 72000,  "meta": 70000,  "activo": yes, "meses": 28, "ingreso": "19/09/2023"},
    {"id": 14, "nombre": "Andrés Reyes",   "region": "Norte",  "producto": "Security Pack",   "venta": 49000,  "meta": 55000,  "activo": no,  "meses": 5,  "ingreso": "01/08/2025"},
    {"id": 15, "nombre": "Sofía Vargas",   "region": "Sur",    "producto": "DevOps Tools",    "venta": 88000,  "meta": 80000,  "activo": yes, "meses": 33, "ingreso": "11/04/2023"},
    {"id": 16, "nombre": "Diego Herrera",  "region": "Centro", "producto": "CRM Pro",         "venta": 95000,  "meta": 85000,  "activo": yes, "meses": 40, "ingreso": "07/09/2022"},
    {"id": 17, "nombre": "Valentina Cruz", "region": "Oeste",  "producto": "Analytics Suite", "venta": 63000,  "meta": 68000,  "activo": yes, "meses": 14, "ingreso": "18/11/2024"},
    {"id": 18, "nombre": "Héctor Romero",  "region": "Norte",  "producto": "Cloud Storage",   "venta": 77000,  "meta": 72000,  "activo": yes, "meses": 26, "ingreso": "25/11/2023"},
    {"id": 19, "nombre": "Adriana Ponce",  "region": "Sur",    "producto": "Security Pack",   "venta": 41000,  "meta": 58000,  "activo": no,  "meses": 4,  "ingreso": "03/09/2025"},
    {"id": 20, "nombre": "Francisco Ríos", "region": "Centro", "producto": "DevOps Tools",    "venta": 102000, "meta": 95000,  "activo": yes, "meses": 52, "ingreso": "01/12/2021"}
]

presupuestos = [
    {"region": "Norte",  "presupuesto": 350000, "obj_clientes": 45},
    {"region": "Sur",    "presupuesto": 280000, "obj_clientes": 38},
    {"region": "Centro", "presupuesto": 320000, "obj_clientes": 42},
    {"region": "Oeste",  "presupuesto": 260000, "obj_clientes": 35}
]

metas_producto = [
    {"producto": "CRM Pro",         "meta_prod": 350000, "comision_pct": 8},
    {"producto": "Analytics Suite", "meta_prod": 280000, "comision_pct": 7},
    {"producto": "Cloud Storage",   "meta_prod": 300000, "comision_pct": 6},
    {"producto": "Security Pack",   "meta_prod": 260000, "comision_pct": 9},
    {"producto": "DevOps Tools",    "meta_prod": 320000, "comision_pct": 10}
]

-- Enriquecer: cumplimiento, estado y categoría por antigüedad
datos = []
for v in vendedores {
    pct    = round((v["venta"] * 100) / v["meta"], 1)
    estado = "Cumple"
    if v["venta"] < v["meta"] {
        estado = "Bajo meta"
    }
    cat = "Junior"
    if v["meses"] >= 12 { cat = "Mid" }
    if v["meses"] >= 30 { cat = "Senior" }
    v["cumplimiento"] = pct
    v["estado"]       = estado
    v["categoria"]    = cat
    datos = datos + [v]
}

-- Joins: vendedores + presupuestos + metas por producto
datos_reg  = excel.cruzar(datos,     presupuestos,   "region",   "left")
datos_full = excel.cruzar(datos_reg, metas_producto, "producto", "left")
datos_full = excel.deduplicar(datos_full, ["nombre"])

-- Fechas: normalizar ingreso y extraer componentes
datos_full = excel.dates(datos_full, "ingreso", "DD/MM/YYYY")
datos_full = excel.date_parts(datos_full, "ingreso", ["year", "month", "quarter"])

-- Segmentos
activos    = excel.filtrar(datos_full, "activo",    "==", yes)
inactivos  = excel.filtrar(datos_full, "activo",    "==", no)
bajo_meta  = excel.filtrar(activos,   "estado",    "==", "Bajo meta")
sobre_meta = excel.filtrar(activos,   "estado",    "==", "Cumple")
senior_ok  = excel.filtrar(sobre_meta,"categoria", "==", "Senior")

-- Agregación por región (activos): columna → función(es)
por_region = excel.agrupar(activos, "region", {
    "venta":        ["sum", "avg", "max"],
    "meta":         ["sum"],
    "cumplimiento": ["avg", "min"],
    "count":        yes
})
por_region = excel.renombrar_col(por_region, "venta_sum",        "total_venta")
por_region = excel.renombrar_col(por_region, "venta_avg",        "prom_venta")
por_region = excel.renombrar_col(por_region, "venta_max",        "mayor_venta")
por_region = excel.renombrar_col(por_region, "meta_sum",         "total_meta")
por_region = excel.renombrar_col(por_region, "cumplimiento_avg", "avg_cumpl")
por_region = excel.renombrar_col(por_region, "cumplimiento_min", "min_cumpl")
por_region = excel.renombrar_col(por_region, "count",            "num_vendedores")
por_region = excel.cruzar(por_region, presupuestos, "region", "left")
por_region = excel.sort(por_region, "total_venta-")

-- Agregación por producto
por_producto = excel.agrupar(datos_full, "producto", {
    "venta":        ["sum", "avg", "max", "min"],
    "cumplimiento": ["avg", "std"],
    "count":        yes
})
por_producto = excel.cruzar(por_producto, metas_producto, "producto", "left")
por_producto = excel.sort(por_producto, "venta_sum-")

-- Agregación por categoría de antigüedad
por_categoria = excel.agrupar(datos_full, "categoria", {
    "venta":        ["sum", "avg", "median"],
    "cumplimiento": ["avg"],
    "meses":        ["avg"],
    "count":        yes
})
por_categoria = excel.sort(por_categoria, "venta_avg-")

-- Agregación por año de ingreso
por_anio = excel.agrupar(datos_full, "ingreso_year", {
    "venta": ["sum", "avg"],
    "count": yes
})
por_anio = excel.sort(por_anio, "ingreso_year+")

-- Estadísticas globales
stats_venta = excel.estadisticas(datos_full, "venta")
stats_cumpl = excel.estadisticas(activos,    "cumplimiento")
stats_meses = excel.estadisticas(datos_full, "meses")

-- Top 10 por venta
ordenado = excel.sort(datos_full, "venta-")
top_10   = []
pos = 1
for row in ordenado {
    if pos <= 10 {
        row["posicion"] = pos
        top_10 = top_10 + [row]
    }
    pos = pos + 1
}
top_10 = excel.seleccionar(top_10, [
    "posicion", "nombre", "region", "producto",
    "venta", "meta", "cumplimiento", "estado", "categoria", "meses"
])

-- Bottom 5 activos por cumplimiento
asc_cumpl = excel.sort(activos, "cumplimiento+")
bottom_5  = []
pos = 1
for row in asc_cumpl {
    if pos <= 5 {
        row["posicion"] = pos
        bottom_5 = bottom_5 + [row]
    }
    pos = pos + 1
}
bottom_5 = excel.seleccionar(bottom_5, [
    "posicion", "nombre", "region", "producto",
    "venta", "meta", "cumplimiento", "estado"
])

-- Pivot y reshape
pivot_reg_prod  = excel.pivot(datos_full, "region", "producto", "venta")
ventas_vs_meta  = excel.seleccionar(datos_full, ["nombre", "region", "venta", "meta"])
ventas_long     = excel.long(ventas_vs_meta, ["nombre", "region"], "metrica", "valor")
ventas_long     = excel.sort(ventas_long, "nombre+", "metrica+")

-- Resumen ejecutivo
total_meta_v = excel.estadisticas(datos_full, "meta").sum
pct_global   = round((stats_venta.sum * 100) / total_meta_v, 1)

resumen = [
    {"metrica": "Vendedores totales",        "valor": len(datos_full),               "unidad": "personas"},
    {"metrica": "Activos",                   "valor": len(activos),                  "unidad": "personas"},
    {"metrica": "Inactivos",                 "valor": len(inactivos),                "unidad": "personas"},
    {"metrica": "Cumplen meta",              "valor": len(sobre_meta),               "unidad": "personas"},
    {"metrica": "Bajo meta",                 "valor": len(bajo_meta),                "unidad": "personas"},
    {"metrica": "Senior que cumplen",        "valor": len(senior_ok),                "unidad": "personas"},
    {"metrica": "Venta total Q1",            "valor": stats_venta.sum,               "unidad": "USD"},
    {"metrica": "Meta total Q1",             "valor": total_meta_v,                  "unidad": "USD"},
    {"metrica": "Cumplimiento global",       "valor": pct_global,                    "unidad": "%"},
    {"metrica": "Venta máxima",              "valor": stats_venta.max,               "unidad": "USD"},
    {"metrica": "Venta mínima",              "valor": stats_venta.min,               "unidad": "USD"},
    {"metrica": "Promedio por vendedor",     "valor": round(stats_venta.avg, 0),     "unidad": "USD"},
    {"metrica": "Mediana de ventas",         "valor": round(stats_venta.mediana, 0), "unidad": "USD"},
    {"metrica": "Desv. estándar ventas",     "valor": round(stats_venta.std, 0),     "unidad": "USD"},
    {"metrica": "Cumpl. promedio activos",   "valor": round(stats_cumpl.avg, 1),     "unidad": "%"},
    {"metrica": "Antigüedad promedio",       "valor": round(stats_meses.avg, 1),     "unidad": "meses"}
]

-- Exportar análisis completo (8 hojas)
show "Generando analisis_completo.xlsx..."
excel.write_multi("demo/analisis_completo.xlsx", {
    "Resumen Ejecutivo": resumen,
    "Por Region":        por_region,
    "Por Producto":      por_producto,
    "Por Categoria":     por_categoria,
    "Por Año Ingreso":   por_anio,
    "Top 10":            top_10,
    "Bottom 5":          bottom_5,
    "Pivot Reg x Prod":  pivot_reg_prod
})

-- Exportar detalle con estilos, fórmulas vivas y gráficos embebidos
show "Generando detalle_formulas.xlsx..."

detalle = excel.seleccionar(
    excel.sort(datos_full, "region+", "venta-"),
    ["id", "nombre", "region", "producto", "venta", "meta",
     "cumplimiento", "estado", "categoria", "meses", "comision_pct",
     "ingreso", "ingreso_year", "ingreso_quarter"]
)

f = excel.f

excel.write_styled("demo/detalle_formulas.xlsx", detalle, {
    "hoja":       "Detalle Q1 2026",
    "titulo":     "Reporte de Ventas Q1 2026",
    "cabecera":   {"fondo": "#1B4F72", "texto": "#FFFFFF"},
    "alternar":   yes,
    "freeze":     yes,
    "autofilter": yes,
    "totales":    ["venta", "meta"],
    "anchos": {
        "id": 6, "nombre": 22, "region": 13, "producto": 18,
        "venta": 14, "meta": 14, "cumplimiento": 16, "estado": 14,
        "categoria": 12, "meses": 10, "comision_pct": 14,
        "ingreso": 14, "ingreso_year": 12, "ingreso_quarter": 14
    },
    "formulas": {
        "comision_usd": f.pct("venta", 8),
        "ratio_meta":   f.ratio("venta", "meta"),
        "acumulado":    f.cumulative("venta"),
        "ranking":      f.rank("venta", "desc"),
        "tier":         f.if_("cumplimiento", ">=", 100, "A", "B")
    },
    "formatos": {
        "venta": {
            "numero": "#,##0",
            "condicional": [
                {"op": ">=", "valor": 90000, "fondo": "#D5F5E3", "texto": "#1E8449"},
                {"op": "<",  "valor": 55000, "fondo": "#FADBD8", "texto": "#922B21"}
            ]
        },
        "meta":         {"numero": "#,##0"},
        "comision_pct": {"numero": "0\"%\""},
        "cumplimiento": {
            "numero": "0.0",
            "condicional": [
                {"op": ">=", "valor": 100, "fondo": "#D5F5E3", "texto": "#1E8449", "bold": yes},
                {"op": "<",  "valor": 85,  "fondo": "#FEF9E7", "texto": "#9A7D0A"},
                {"op": "<",  "valor": 75,  "fondo": "#FADBD8", "texto": "#922B21"}
            ]
        },
        "estado": {
            "condicional": [
                {"op": "==", "valor": "Cumple",    "fondo": "#D5F5E3", "texto": "#1E8449"},
                {"op": "==", "valor": "Bajo meta", "fondo": "#FADBD8", "texto": "#922B21"}
            ]
        }
    },
    "charts": [
        {
            "type": "bars", "x": "nombre", "y": ["venta", "meta"],
            "title": "Venta vs Meta por Vendedor",
            "x_title": "Vendedor", "y_title": "USD",
            "sheet": "Chart Venta-Meta", "palette": "orion",
            "width": 960, "height": 520
        },
        {
            "type": "lines", "x": "nombre", "y": ["cumplimiento"],
            "title": "Cumplimiento % por Vendedor",
            "x_title": "Vendedor", "y_title": "%",
            "sheet": "Chart Cumplimiento", "palette": "vivid",
            "smooth": yes, "width": 960, "height": 420
        }
    ]
})

-- Gráfico standalone: venta vs meta vs presupuesto por región
show "Generando chart_regiones.xlsx..."

region_chart = excel.seleccionar(
    excel.sort(por_region, "region+"),
    ["region", "total_venta", "total_meta", "presupuesto"]
)

excel.chart("demo/chart_regiones.xlsx", region_chart, {
    "type": "bars", "x": "region", "y": ["total_venta", "total_meta", "presupuesto"],
    "title": "Venta vs Meta vs Presupuesto por Región Q1 2026",
    "x_title": "Región", "y_title": "USD",
    "data_sheet": "Datos Regionales", "sheet": "Gráfico Regional",
    "palette": "corporate", "width": 820, "height": 500
})

-- Validar archivos generados con excel.sheet (F-9)
attempt {
    s1 = excel.sheet("demo/analisis_completo.xlsx", "Resumen Ejecutivo")
    s2 = excel.sheet("demo/detalle_formulas.xlsx")
    show "OK analisis_completo  - Resumen: " + s1.rows + " filas"
    show "OK detalle_formulas   - Detalle: " + s2.rows + " filas, " + s2.cols + " columnas"
    if s2.rows != len(datos_full) {
        show "AVISO: filas esperadas=" + len(datos_full) + " generadas=" + s2.rows
    }
} handle e {
    show "Aviso validacion: " + e
}

-- Resumen final
show ""
show "Vendedores: " + len(datos_full) + " total, " + len(activos) + " activos, " + len(inactivos) + " inactivos"
show "Cumplen: " + len(sobre_meta) + "  Bajo meta: " + len(bajo_meta) + "  Senior OK: " + len(senior_ok)
show "Venta total: USD " + stats_venta.sum + "  Cumplimiento: " + pct_global + "%"
show "Max: USD " + stats_venta.max + "  Mediana: USD " + round(stats_venta.mediana, 0)
show ""
show "Archivos generados:"
show "  demo/analisis_completo.xlsx  (8 hojas)"
show "  demo/detalle_formulas.xlsx   (estilos + formulas vivas + 2 charts)"
show "  demo/chart_regiones.xlsx     (chart standalone)"
