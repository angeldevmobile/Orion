-- reporte_cli.orx — El mismo reporte, sin interfaz, para automatizar.
--
--   orion run demo/reporte_cli.orx demo/demo_data.xlsx 913916
--   orion run demo/reporte_cli.orx demo/demo_data.xlsx 913916 salida.xlsx
--
-- Usa exactamente la misma lógica que el panel (demo/reporte_lib.orx), así que
-- lo que se ve en pantalla y lo que sale por consola no pueden divergir.
use "process" as proc
use "excel" as xl
use "format" as fmt
use "demo/reporte_lib" as rep

argv = proc.args()

if len(argv) < 2 {
    show "Uso: orion run demo/reporte_cli.orx <archivo.xlsx> <operacion> [salida.xlsx]"
    show ""
    show "  archivo.xlsx  libro con la cartera"
    show "  operacion     número de operación a consultar"
    show "  salida.xlsx   si se indica, escribe el reporte en ese archivo"
    exit(1)
}

archivo   = argv[0]
operacion = argv[1]
salida    = ""
if len(argv) > 2 { salida = argv[2] }

datos = xl.read(archivo)
ficha = rep.ficha(datos, operacion)

if ficha == null {
    show "La operación " + operacion + " no está en " + archivo
    exit(2)
}

cab   = ficha["cabecera"]
tot   = ficha["totales"]
certs = ficha["certificados"]

show "OPERACIÓN " + cab["operacion"]
show "  Contratante : " + cab["contratante"]
show "  Situación   : " + cab["situacion"]
show "  Gestión     : " + cab["gestion"]
show "  Estado      : " + cab["estado"]
show "  Riesgo      : " + cab["riesgo"] + "   Garantía: " + cab["garantia"]
show "  Aseguradora : " + cab["aseguradora"]
if cab["observacion"] != "—" {
    show "  Observación : " + cab["observacion"]
}
show ""
show "  Certificados  : " + str(tot["certificados"])
show "  Suma asegurada: " + fmt.number(tot["suma"], 2) + " " + cab["moneda"]
show "  Prima neta    : " + fmt.number(tot["prima_neta"], 2)
show "  Prima bruta   : " + fmt.number(tot["prima_bruta"], 2)
show ""

for c in certs {
    linea = "  " + c["numero"] + "  " + c["desde"] + " a " + c["hasta"]
              + "  " + fmt.number(c["suma"], 2)
    if c.has_key("placa") {
        linea = linea + "  [" + c["placa"] + " " + c["marca"] + "]"
    }
    show linea
}

if salida != "" {
    resumen = []
    for par in [
        ["Operación",      cab["operacion"]],
        ["Contratante",    cab["contratante"]],
        ["Detalle",        cab["detalle"]],
        ["Situación",      cab["situacion"]],
        ["Gestión",        cab["gestion"]],
        ["Observaciones",  cab["observacion"]],
        ["Estado",         cab["estado"]],
        ["Riesgo",         cab["riesgo"]],
        ["Garantía",       cab["garantia"]],
        ["Aseguradora",    cab["aseguradora"]],
        ["Moneda",         cab["moneda"]],
        ["Certificados",   str(tot["certificados"])],
        ["Suma asegurada", fmt.number(tot["suma"], 2)],
        ["Prima neta",     fmt.number(tot["prima_neta"], 2)],
        ["Prima bruta",    fmt.number(tot["prima_bruta"], 2)]
    ] {
        resumen = push(resumen, { "Campo": par[0], "Valor": par[1] })
    }
    xl.write_multi(salida, { "Resumen": resumen, "Certificados": certs })
    show ""
    show "Escrito: " + salida
}
