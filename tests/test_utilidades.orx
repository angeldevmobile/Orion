-- Barrido funcional e2e de los módulos de utilidades: datetime, timewarp, formato.
-- Checks exactos con valores calculados a mano.
-- Ejecutar desde la raíz del repo: orion test tests
use "datetime" as dt
use "timewarp" as tw
use "formato" as fmt
use "strings" as st

--    datetime

fn test_dt_parse_formatos() {
    -- día-primero, misma convención que table.cast(col, "date")
    assert_eq(dt.format("15/03/2026", "%Y-%m-%d"), "2026-03-15", "parse dd/mm/yyyy")
    assert_eq(dt.format("2026-03-15", "%d/%m/%Y"), "15/03/2026", "format a dd/mm")
    assert_eq(dt.format("2026-03-15 08:30", "%H:%M"), "08:30", "parse sin segundos")
    ok = no
    attempt {
        dt.format("no es fecha")
    } handle err {
        ok = yes
    }
    assert(ok, "fecha inválida lanza error")
}

fn test_dt_aritmetica() {
    assert_eq(dt.add_days("2026-01-31", 1), "2026-02-01T00:00:00", "add_days cruza mes")
    assert_eq(dt.add_hours("2026-01-01T23:30:00", 2), "2026-01-02T01:30:00", "add_hours cruza día")
    assert_eq(dt.add_minutes("2026-01-01T10:00:00", 90), "2026-01-01T11:30:00", "add_minutes")
    -- fin de mes ajustado
    assert_eq(dt.add_months("2026-01-31", 1), "2026-02-28T00:00:00", "add_months ajusta fin de mes")
    assert_eq(dt.add_months("2024-01-31", 1), "2024-02-29T00:00:00", "add_months bisiesto")
    assert_eq(dt.add_months("2026-03-15", -2), "2026-01-15T00:00:00", "add_months negativo")
    assert_eq(dt.add_years("2024-02-29", 1), "2025-02-28T00:00:00", "add_years ajusta bisiesto")
}

fn test_dt_diferencias() {
    assert_eq(dt.diff_days("2026-01-01", "2026-01-10"), 9, "diff_days")
    assert_eq(dt.diff_hours("2026-01-01T00:00:00", "2026-01-02T06:00:00"), 30, "diff_hours")
    assert_eq(dt.diff_minutes("2026-01-01T10:00:00", "2026-01-01T11:30:00"), 90, "diff_minutes")
    assert_eq(dt.diff_seconds("2026-01-01T10:00:00", "2026-01-01T10:01:30"), 90, "diff_seconds")
}

fn test_dt_partes_y_semana() {
    p = dt.parts("2026-07-18T14:30:45")
    assert_eq(p["year"], 2026, "parts year")
    assert_eq(p["month"], 7, "parts month")
    assert_eq(p["day"], 18, "parts day")
    assert_eq(p["hour"], 14, "parts hour")
    assert_eq(p["minute"], 30, "parts minute")
    assert_eq(p["second"], 45, "parts second")
    assert_eq(dt.weekday("2026-07-18"), "Saturday", "weekday inglés")
    assert_eq(dt.weekday("2026-07-18", "es"), "sábado", "weekday español")
}

fn test_dt_limites_de_mes() {
    assert_eq(dt.start_of_month("2026-07-18"), "2026-07-01", "start_of_month")
    assert_eq(dt.end_of_month("2026-02-10"), "2026-02-28", "end_of_month febrero")
    assert_eq(dt.end_of_month("2024-02-10"), "2024-02-29", "end_of_month bisiesto")
    assert_eq(dt.end_of_month("2026-04-05"), "2026-04-30", "end_of_month 30 días")
    assert_eq(dt.from_date(2026, 7, 18), "2026-07-18", "from_date")
    ok = no
    attempt {
        dt.from_date(2026, 2, 30)
    } handle err {
        ok = yes
    }
    assert(ok, "from_date inválida lanza error")
}

fn test_dt_puente_unix() {
    -- roundtrip datetime ↔ unix (el hueco que había entre datetime y timewarp)
    iso = "2026-07-18T12:00:00"
    ts = dt.to_timestamp(iso)
    assert_eq(dt.from_timestamp(ts), iso, "to/from_timestamp roundtrip")
    ts2 = dt.to_timestamp("2026-07-18T12:01:00")
    assert_eq(ts2 - ts, 60, "timestamps difieren en segundos exactos")
    assert_eq(dt.is_past("2000-01-01"), yes, "is_past")
    assert_eq(dt.is_future("2100-01-01"), yes, "is_future")
}

--    timewarp

fn test_tw_timestamps() {
    ts = tw.timestamp()
    assert(ts > 1750000000, "timestamp es época actual")
    ms = tw.timestamp_ms()
    assert(ms >= ts * 1000, "ms coherente con segundos")
    assert(ms < (ts + 2) * 1000, "ms no se aleja de segundos")
    assert_eq(tw.add(100, 50), 150, "add")
    assert_eq(tw.sub(100, 30), 70, "sub")
    assert_eq(tw.diff(10, 25), 15, "diff")
    assert_eq(tw.diff(25, 10), 15, "diff absoluto")
    assert(tw.since(ts - 100) >= 100, "since al menos lo esperado")
    assert(tw.since(ts - 100) <= 103, "since sin deriva")
    assert(tw.until(ts + 100) <= 100, "until acotado arriba")
    assert(tw.until(ts + 100) >= 97, "until acotado abajo")
}

fn test_tw_clock_y_wait() {
    t = tw.clock()
    tw.wait("50ms")
    e = tw.elapsed(t)
    assert(e >= 0.04, "elapsed registra la espera")
    assert(e < 2.0, "elapsed en rango razonable")
    tw.wait(0.01)
    assert(yes, "wait acepta número en segundos")
}

fn test_tw_format_coherente_con_datetime() {
    ts = dt.to_timestamp("2026-07-18T12:00:00")
    assert_eq(tw.format(ts, "%Y-%m-%d %H:%M"), "2026-07-18 12:00", "format coincide con datetime")
}

fn test_tw_measure_time_retirado() {
    ok = no
    attempt {
        tw.measure_time()
    } handle err {
        ok = yes
    }
    assert(ok, "measure_time retirado lanza error con guía")
}

--    formato

fn test_fmt_numero() {
    assert_eq(fmt.numero(1487000), "1,487,000", "miles por defecto")
    assert_eq(fmt.numero(1234567.891, 2), "1,234,567.89", "decimales")
    assert_eq(fmt.numero(1234567, 0, ".", ","), "1.234.567", "estilo español")
    assert_eq(fmt.numero(1234.5, 1, ".", ","), "1.234,5", "español con decimal")
    assert_eq(fmt.numero(-9876.5, 1), "-9,876.5", "negativo")
    assert_eq(fmt.numero(999), "999", "sin separador bajo mil")
    assert_eq(fmt.numero(1000), "1,000", "límite del millar")
}

fn test_fmt_moneda_porcentaje() {
    assert_eq(fmt.moneda(1487000, "USD"), "USD 1,487,000.00", "moneda con código")
    assert_eq(fmt.moneda(99.9), "$99.90", "moneda símbolo por defecto")
    assert_eq(fmt.moneda(5000, "€", 0), "€5,000", "moneda sin decimales")
    assert_eq(fmt.porcentaje(0.156), "15.6%", "porcentaje por defecto")
    assert_eq(fmt.porcentaje(0.5, 0), "50%", "porcentaje sin decimales")
    assert_eq(fmt.porcentaje(1.25, 2), "125.00%", "porcentaje sobre 100")
}

fn test_fmt_bytes_duracion() {
    assert_eq(fmt.bytes(512), "512 B", "bytes")
    assert_eq(fmt.bytes(1536), "1.5 KB", "kilobytes")
    assert_eq(fmt.bytes(1048576), "1 MB", "megabytes exactos sin decimal")
    assert_eq(fmt.bytes(2621440), "2.5 MB", "megabytes con decimal")
    assert_eq(fmt.bytes(0), "0 B", "cero bytes")
    assert_eq(fmt.duracion(45), "45s", "segundos")
    assert_eq(fmt.duracion(125), "2m 5s", "minutos y segundos")
    assert_eq(fmt.duracion(3600), "1h", "hora exacta")
    assert_eq(fmt.duracion(90061), "1d 1h 1m 1s", "días completos")
    assert_eq(fmt.duracion(0), "0s", "cero")
    assert_eq(fmt.duracion(0.5), "500ms", "sub-segundo")
}

fn test_fmt_texto() {
    assert_eq(fmt.centrar("ab", 6), "  ab  ", "centrar")
    assert_eq(fmt.centrar("abcdef", 4), "abcdef", "centrar no recorta")
    assert_eq(fmt.separador(5, "="), "=====", "separador")
    assert_eq(fmt.separador(0), "", "separador cero")
    assert_eq(fmt.truncar("orionlang", 6), "orion…", "truncar con elipsis")
    assert_eq(fmt.truncar("abc", 10), "abc", "truncar sin necesidad")
    t = fmt.tabla(["col_a", "col_b"], [[1, 2], [3, 4]])
    assert(st.contains(t, "col_a"), "tabla incluye encabezado")
    assert(st.contains(t, "3"), "tabla incluye datos")
    td = fmt.tabla(["x"], [{ "x": 9 }])
    assert(st.contains(td, "9"), "tabla acepta filas dict")
}
