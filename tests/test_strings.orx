fn test_concatenacion() {
    s = "Hola" + " " + "Orion"
    assert_eq(s, "Hola Orion", "concat strings")
}

fn test_longitud() {
    assert_eq(len("abc"), 3, "len de string")
    assert_eq(len(""), 0, "len de string vacio")
}

-- que el runner detecta fallos se verifica sin ensuciar la suite:
-- un assert que FALLA dentro de attempt debe lanzar error atrapable
fn test_runner_detecta_fallos() {
    atrapado = no
    attempt {
        assert_eq(1, 2, "fallo esperado")
    } handle err {
        atrapado = yes
    }
    assert(atrapado, "assert_eq fallido lanza error atrapable")
}
