use "db" as db
use "env" as env
use "timewarp" as tw
URL = env.pull("ORION_PG_URL")
N = 500000
fn rps(n, s) { if s <= 0 { return "inf" } return str(int(n / s)) }

db.ejecutar(URL, "DROP TABLE IF EXISTS bigload")
db.ejecutar(URL, "CREATE TABLE bigload (id INTEGER, nombre TEXT, valor INTEGER, precio NUMERIC(12,2))")

-- Construir 500k filas con push (muta in-place, O(1) por fila)
reloj = tw.clock()
filas = []
i = 0
while i < N {
    filas.push([i, "producto" + str(i), i * 7, i * 0.99])
    i = i + 1
}
tBuild = tw.elapsed(reloj)
show "construir " + str(N) + " filas (push): " + str(tBuild) + "s"

reloj = tw.clock()
n = db.copiar(URL, "bigload", ["id", "nombre", "valor", "precio"], filas)
tCopy = tw.elapsed(reloj)
show "COPY " + str(n) + " filas: " + str(tCopy) + "s  → " + rps(n, tCopy) + " filas/s"

r = db.uno(URL, "SELECT count(*) as c, sum(valor) as s FROM bigload")
show "verificado: " + str(r["c"]) + " filas"

db.ejecutar(URL, "DROP TABLE bigload")
db.cerrar(URL)
